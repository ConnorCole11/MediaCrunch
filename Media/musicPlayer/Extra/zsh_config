# /tmp/my_custom_zshrc
function prefill_command() {
  if [[ -z "$ZSH_PREFILLED" ]]; then
    BUFFER="python play_playlist.py --Playlist "
    CURSOR=${#BUFFER}
    export ZSH_PREFILLED=1
  fi
}
zle -N prefill_command
autoload -Uz add-zsh-hook
add-zsh-hook precmd prefill_command

